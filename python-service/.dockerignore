# ==================== python-service/.dockerignore ====================
# 环境变量：含敏感 Key，禁止进入镜像（运行时通过 env_file 注入）
.env
.env.*
!.env.example

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# 版本控制与编辑器
.git
.gitignore
.vscode
.idea
.DS_Store

# 本地数据与日志
*.db
*.log
