{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://careerlens.ai/contracts/error-envelope.schema.json",
  "title": "统一错误信封",
  "description": "四层链路统一的错误响应结构。error.code 取值见 error-codes.md。",
  "type": "object",
  "required": ["requestId", "success", "error"],
  "properties": {
    "requestId": {
      "type": "string",
      "description": "全链路请求标识，由 BFF 生成并透传",
      "minLength": 1
    },
    "success": {
      "type": "boolean",
      "description": "恒为 false（错误响应）",
      "const": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "degraded"],
      "properties": {
        "code": {
          "type": "string",
          "description": "错误码枚举，见 contracts/error-codes.md",
          "enum": [
            "VALIDATION_ERROR",
            "EMPTY_INPUT",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_ERROR",
            "SERVICE_UNAVAILABLE",
            "LLM_ERROR",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "description": "面向用户的友好中文提示",
          "minLength": 1
        },
        "degraded": {
          "type": "boolean",
          "description": "true 表示结果由规则引擎兜底产出（未使用 LLM）"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
